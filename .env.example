# كلمة مرور الدخول للتطبيق (يمكن وضع النص أو هاش SHA-256 مكون من 64 خانة سداسية عشرية - موصى به)
# مثال نص عادي:
# VITE_APP_PASSWORD=your-strong-password
#
# مثال هاش SHA-256 (يُفضّل في بيئة الإنتاج حتى لا يظهر النص في ملفات البناء):
# لتوليد الهاش: node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
#
# ملاحظة: في حال ترك المتغير فارغاً أثناء التشغيل المحلي، تُستخدم كلمة مرور تجريبية افتراضية (1234) للتجربة فقط.
VITE_APP_PASSWORD=123456
